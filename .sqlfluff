[sqlfluff]
dialect = snowflake
output_line_length = 200
max_line_length = 200
# TODO confluence hanei
exclude_rules = RF01,RF02,RF03,AL05,AM02,AM04,CV02,LT04,LT08,LT09,ST02,ST05,ST06,TQ01
large_file_skip_char_limit = 0
large_file_skip_byte_limit = 0
#templater = dbt

#[sqlfluff:templater:dbt]
#project_dir = ./
#profiles_dir = ./dbt_products/enterprise_data_products/
#profile = default
#target = dev

[sqlfluff:rules:aliasing.table]
# AL01
aliasing = implicit

[sqlfluff:rules:aliasing.length]
# AL06
# min_alias_length = None
max_alias_length = 30

[sqlfluff:rules:ambiguous.column_references]
# AM06
group_by_and_order_by_style = explicit

[sqlfluff:rules:capitalisation.keywords]
# CP01
# Keywords
capitalisation_policy = lower
# Comma separated list of words to ignore for this rule
# ignore_words = None
# ignore_words_regex = None

[sqlfluff:rules:capitalisation.identifiers]
# CP02
# Unquoted identifiers
extended_capitalisation_policy = lower
# Comma separated list of words to ignore for this rule
# ignore_words = None
# ignore_words_regex = None

[sqlfluff:rules:capitalisation.functions]
# CP03
# Function names
extended_capitalisation_policy = lower
# Comma separated list of words to ignore for this rule
# ignore_words = None
# ignore_words_regex = None

[sqlfluff:rules:capitalisation.literals]
# CP04
# Null & Boolean Literals
capitalisation_policy = lower
# Comma separated list of words to ignore for this rule
# ignore_words = None
# ignore_words_regex = None

[sqlfluff:rules:capitalisation.types]
# CP05
# Data Types
extended_capitalisation_policy = lower
# Comma separated list of words to ignore for this rule
# ignore_words = None
# ignore_words_regex = None

[sqlfluff:rules:convention.blocked_words]
# CV09
# Comma separated list of blocked words that should not be used
blocked_words = None
blocked_regex = None
match_source = False

[sqlfluff:rules:layout.long_lines]
# LT05
# Line length
ignore_comment_lines = True
ignore_comment_clauses = True

[sqlfluff:rules:references.from]
# RF01
# References must be in FROM clause
# Disabled for some dialects (e.g. bigquery)
force_enable = False

[sqlfluff:rules:references.consistent]
# RF03
# References must be consistently used
# Disabled for some dialects (e.g. bigquery)
force_enable = False

[sqlfluff:rules:references.keywords]
# RF04
# Keywords should not be used as identifiers.
# unquoted_identifiers_policy = all
# quoted_identifiers_policy = none
# Comma separated list of words to ignore for this rule
# ignore_words = ".","_"
# ignore_words_regex = None

[sqlfluff:rules:references.special_chars]
# RF05
# Special characters in identifiers
# unquoted_identifiers_policy = all
quoted_identifiers_policy = aliases
# allow_space_in_identifier = False
# additional_allowed_characters = None
# ignore_words = None
ignore_words_regex = [.-]