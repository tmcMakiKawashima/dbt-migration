# dbt 接続情報
DBT_SNOWFLAKE_ACCOUNT=****
DBT_SNOWFLAKE_DATABASE=****
DBT_SNOWFLAKE_PASS=****
DBT_SNOWFLAKE_ROLE=****
DBT_SNOWFLAKE_SCHEMA=****
DBT_SNOWFLAKE_USER=****

# dbt deploy environment
dbt_deploy_env=****
# dbt target
dbt_profile_enterprise=dev
# sensor
DAGSTER_SENSOR_GRPC_TIMEOUT_SECONDS=300
SENSOR_MINI_INTERVAL_SEC=180
# api
X_TMC_CLIENT_ID=****
X_TMC_CLIENT_SECRET=****
X_TMC_ZDFW_USERID=****
X_TMC_ZDFW_COMPCODE=****
X_TMC_CLIENT_ID_SMS=****
X_TMC_CLIENT_SECRET_SMS=****
X_TMC_ZDFW_USERID_SMS=****
X_TMC_ZDFW_COMPCODE_SMS=****

# 設定方法
#    ローカル環境は本ファイルで定義されている環境変数を参照する
#    クラウド環境はUIで定義した環境変数を参照する

# 特性
#    ローカル環境はコードロケーションごとに参照する環境変数を変更できない
#    クラウド環境はコードロケーションごとに参照する環境変数を変更できる

# 環境変数でコードロケーション名を定義している理由
#    前提としてアセットはDagster内で一意である必要があるため、コードロケーション間でアセット名が同じ場合取り込めない
#    資材リリースする際にソースコードに手を加えずに、別物として認識させる必要がある
#    対策はkey_prefix(識別子)をアセットに定義することでアセット名が同じ場合でも識別できるようにする
#    key_prefixに環境変数を使うことで同じE層のアセットでも
#     da_code_location_e_layer/asset01
#     sa_code_location_e_layer/asset01
#     pa_code_location_e_layer/asset01
#    のように区別できるようにする

# dbt_resource_edpの利用用途
#    dbtのsources.ymlのソース名と一致させる
#    dbt_resource_edp=edp_db

